      "text": "select \nuserId, count(*) as passedSubmisison\nfrom submissions\nwhere compId = :compID AND passed = true\ngroupBy userId\norderBy passedSubmisison DESC, lastSubmisisonTime ASC, runtime ASC",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "select \nuserId, count(*) as passedSubmisison\nfrom submissions\nwhere compId = :compID AND passed = true\ngroupBy userId\norderBy passedSubmisison DESC, lastSubmisisonTime ASC, runtime ASC",

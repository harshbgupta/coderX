      "isDeleted": false,
      "boundElements": null,
      "updated": 1786192089423,
      "link": null,
      "locked": false,
      "text": "Func requirements:\n- list of problems\n- see the individual prob\n- submit the solution\n- support competition and leaderboard\n\nnon-func requirements:\n- availability >> consistency\n- scalable 10K questions, 100K users at smae competetions\n- realtime leaderboard\n- security and Isolation\n\ncore-entities\n- user\n- problems\n- solutions\n- competition\n\napis\n- GET /problems?category=:category&difficulty:diff&page:p&size:s\n    res:{problems:[]}\n- GET /problems/:probId\n    res:{poblem}\n- POST /problem/:problemId\n    res:{competitionId, language, code}\n- GET /leaderboard?competition=:compId&page=:page&size=:size\n    res:{\n         //users ranking in order\n    }\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Func requirements:\n- list of problems\n- see the individual prob\n- submit the solution\n- support competition and leaderboard\n\nnon-func requirements:\n- availability >> consistency\n- scalable 10K questions, 100K users at smae competetions\n- realtime leaderboard\n- security and Isolation\n\ncore-entities\n- user\n- problems\n- solutions\n- competition\n\napis\n- GET /problems?category=:category&difficulty:diff&page:p&size:s\n    res:{problems:[]}\n- GET /problems/:probId\n    res:{poblem}\n- POST /problem/:problemId\n    res:{competitionId, language, code}\n- GET /leaderboard?competition=:compId&page=:page&size=:size\n    res:{\n         //users ranking in order\n    }\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

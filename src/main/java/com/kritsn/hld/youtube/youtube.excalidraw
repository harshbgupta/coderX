    {
      "id": "Wvu372spb4l8g8Tby7cyh",
      "type": "text",
      "x": -86.47401825199313,
      "y": -3371.63543837844,
      "width": 325.5999755859375,
      "height": 580,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b93",
      "roundness": null,
      "seed": 1833911356,
      "version": 689,
      "versionNonce": 427947964,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786124734307,
      "link": null,
      "locked": false,
      "text": "Requirments:\nFunctional:\n- upload the video\n- watch/stream the video\n\nnon-functional\n- availability>> consistency\n- scale ( 1M+ uploads/day, 100M DAU)\n- max video size 250GB (upload)\n- low latency (no buffering)\n\n--- out of scope ---\n- streaming\n- user onboarding\n- comments\n- push notifications (subscribers)\n\n\ncore entities\n- video\n- videoMetadata\n- user\n\napi:\n- POST: video/upload\n    res: {preSignedS3Url, metadata..}\n- GET: video/:videoId\n    res: {preSignedS3Url, metadata..}\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Requirments:\nFunctional:\n- upload the video\n- watch/stream the video\n\nnon-functional\n- availability>> consistency\n- scale ( 1M+ uploads/day, 100M DAU)\n- max video size 250GB (upload)\n- low latency (no buffering)\n\n--- out of scope ---\n- streaming\n- user onboarding\n- comments\n- push notifications (subscribers)\n\n\ncore entities\n- video\n- videoMetadata\n- user\n\napi:\n- POST: video/upload\n    res: {preSignedS3Url, metadata..}\n- GET: video/:videoId\n    res: {preSignedS3Url, metadata..}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

    {
      "id": "ISPFVOai_k5GwrxX2R0SM",
      "type": "text",
      "x": 2711.8277029495625,
      "y": -2498.2581980763393,
      "width": 501.5997314453125,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "BDjYwcvP_EQ-qgj31cVMV",
      "index": "b8zV",
      "roundness": null,
      "seed": 738609340,
      "version": 520,
      "versionNonce": 799809412,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786122719420,
      "link": null,
      "locked": false,
      "text": "in-memory data\nadId:1 (for every ad)\nminute 45, count 10000\nminute 46, count 20000\n- and pushes data every minute (the granular unit)\n\n- also support flush system, so it can hit DB \nto store data like 10 sec, this help in to reduce latency",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "in-memory data\nadId:1 (for every ad)\nminute 45, count 10000\nminute 46, count 20000\n- and pushes data every minute (the granular unit)\n\n- also support flush system, so it can hit DB \nto store data like 10 sec, this help in to reduce latency",
      "autoResize": true,
      "lineHeight": 1.25
    },

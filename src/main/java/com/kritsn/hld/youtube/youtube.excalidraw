    {
      "id": "VYqtCcB9TiE0CYXnw2woc",
      "type": "text",
      "x": 1764.7296724594871,
      "y": -2769.6234013907915,
      "width": 598.3995971679688,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "BDjYwcvP_EQ-qgj31cVMV",
      "index": "b8zH",
      "roundness": null,
      "seed": 1993365564,
      "version": 711,
      "versionNonce": 128647556,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1786122719420,
      "link": null,
      "locked": false,
      "text": "There are two way\n1. user clicks an ad(at this time user redirection Url) \nand redirected to ads website and parallelly we log the data\n2. At this moment we have only the ad id (no redirection url), \nso user click an ad we hit the clicl processor service with \nad id, here we validation the ata and get the redirection url\n from DB and send it to server, and meanwhile we also do the logging",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There are two way\n1. user clicks an ad(at this time user redirection Url) \nand redirected to ads website and parallelly we log the data\n2. At this moment we have only the ad id (no redirection url), \nso user click an ad we hit the clicl processor service with \nad id, here we validation the ata and get the redirection url\n from DB and send it to server, and meanwhile we also do the logging",
      "autoResize": true,
      "lineHeight": 1.25
    },
